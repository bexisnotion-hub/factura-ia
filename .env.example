# ── IA ──────────────────────────────────────────────────────────────
# Al menos una API key es obligatoria. El sistema usa cascada automática:
# Gemini → Claude Vision → OCR local (sin clave)
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# ── Servidor ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Autenticación del panel/API ──────────────────────────────────────
# Obligatorio cuando NODE_ENV=production. Si está vacío en producción,
# el servidor se niega a arrancar para evitar exponer la API sin auth.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_TOKEN=

# ── URL pública ──────────────────────────────────────────────────────
# URL completa donde estará accesible el panel (sin barra final).
# Railway asigna automáticamente algo como: https://factura-ia.up.railway.app
# Se usa en los mensajes de WhatsApp para enviar el enlace al panel.
PUBLIC_URL=https://tu-app.up.railway.app

# Lista de orígenes permitidos para CORS, separados por coma.
# Vacío o no definido = mismo origen únicamente.
# En Railway, pon el mismo valor que PUBLIC_URL.
CORS_ORIGIN=https://tu-app.up.railway.app

# ── WhatsApp ─────────────────────────────────────────────────────────
# Directorio donde se guarda la sesión de WhatsApp (no lo borres)
WHATSAPP_SESSION_DIR=auth_info_baileys
